<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_main"
    android:padding="12dp">

    <!-- Header for Orders -->
    <TextView
        android:id="@+id/order_summary_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Orders"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/red"
        android:layout_marginBottom="8dp" />

    <!-- Scrollable container with explicit height -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="100dp"

    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/order_summary_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</ScrollView>


<TextView
android:id="@+id/total_amount"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Total: 0 PHP"
android:textSize="18sp"
android:textColor="@color/red"
android:layout_marginTop="8dp" />


<Button
android:id="@+id/confirm_order_button"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Confirm Order"
android:background="@drawable/rounded_confirm_btn"
android:textColor="@color/golden_yellow"
android:layout_marginTop="16dp" />
    </LinearLayout>


